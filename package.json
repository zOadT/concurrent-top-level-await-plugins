{
  "name": "concurrent-top-level-await-plugins",
  "private": true,
  "description": "Bundler plugins enabling concurrent execution of modules that contain top level await.",
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "changeset": "changeset",
    "prerelease": "vp run build",
    "release": "pnpm -r publish --access=public && changeset tag",
    "version": "changeset version",
    "format": "vp fmt",
    "check": "vp check",
    "test": "vp test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zOadT/concurrent-top-level-await-plugins.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "author": "Oliver Zell",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zOadT/concurrent-top-level-await-plugins/issues"
  },
  "homepage": "https://github.com/zOadT/concurrent-top-level-await-plugins#readme",
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3",
    "unplugin-macros": "^0.19.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}
